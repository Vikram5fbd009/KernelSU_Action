# KernelSU Action -- build profile
CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/Vikram5fbd009/Overclock_mt6833
KERNEL_SOURCE_BRANCH=backport-path_umount
KERNEL_CONFIG=camellian_in_eea_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# ⚠️ FIX 1: gnu- (kernel Makefile:503 requirement) + KCFLAGS
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu- KCFLAGS=-Wno-error=strict-prototypes
EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes

# =================================================================== Clang ==

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# ⚠️ FIX 2: LLVM=1 LLVM_IAS=1 = integrated assembler, no external as
USE_LLVM=true

# ===================================================================== GCC ==

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===

KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=none
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==

ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=false
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===

NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
